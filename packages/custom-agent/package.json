{
  "name": "@google/gemini-cli-custom-agent",
  "version": "0.1.0",
  "description": "Custom Gemini CLI Agent for AionUi with message editing support",
  "type": "module",
  "main": "dist/src/cli.js",
  "bin": {
    "custom-agent": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
